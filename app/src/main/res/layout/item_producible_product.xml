<?xml version="1.0" encoding="utf-8"?>
<!--
    Producible-product (CanProduce) grid tile.
    Designed for the 3-column GridLayoutManager. Compact card with name +
    category, an emphasised availability number, price/value split, and a
    single action row (View / Edit / Delete) sitting on a divider.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/pos_surface"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/pos_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvProducibleName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:minLines="2"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.Headline"
            android:textColor="@color/pos_text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Cappuccino Grande" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvProducibleCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
                android:textColor="@color/pos_text_secondary"
                tools:text="Coffee" />

            <TextView
                android:id="@+id/tvProducibleVariant"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_hint_chip"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="10dp"
                android:paddingTop="4dp"
                android:paddingEnd="10dp"
                android:paddingBottom="4dp"
                android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
                android:textColor="@color/pos_text_secondary"
                tools:text="Standard" />
        </LinearLayout>

        <!-- Available-to-make hero -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_hint_chip"
            android:backgroundTint="@color/dashboard_section_soft"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Available to make"
                android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
                android:textColor="@color/pos_text_secondary" />

            <TextView
                android:id="@+id/tvProducibleQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.ZejiosCafe.KpiValue"
                android:textColor="@color/pos_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                tools:text="42 servings" />

            <TextView
                android:id="@+id/tvProducibleStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                android:textColor="@color/stock_good"
                tools:text="In stock" />
        </LinearLayout>

        <!-- Price / Value split -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Price"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
                    android:textColor="@color/pos_text_secondary" />

                <TextView
                    android:id="@+id/tvProduciblePrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyLarge"
                    android:textColor="@color/pos_text_primary"
                    tools:text="PHP 145.00" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Est. value"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
                    android:textColor="@color/pos_text_secondary" />

                <TextView
                    android:id="@+id/tvProducibleValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                    android:textColor="@color/pos_secondary"
                    android:textStyle="bold"
                    tools:text="PHP 6,090" />
            </LinearLayout>
        </LinearLayout>

        <!-- Divider before action row -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/pos_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewProductIngredients"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:contentDescription="@string/inventory_view_ingredients"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="View"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                android:textColor="@color/pos_text_primary"
                app:backgroundTint="@color/pos_surface_header"
                app:cornerRadius="14dp"
                app:strokeColor="@color/pos_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditProduct"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:contentDescription="@string/edit"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/edit"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                android:textColor="@color/pos_text_primary"
                app:backgroundTint="@color/pos_surface_header"
                app:cornerRadius="14dp"
                app:strokeColor="@color/pos_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteProduct"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:contentDescription="@string/inventory_soft_delete_product"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                app:backgroundTint="@color/pos_critical_soft"
                app:cornerRadius="14dp"
                app:icon="@android:drawable/ic_menu_delete"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="18dp"
                app:iconTint="@color/stock_critical"
                app:strokeColor="@color/pos_border"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
