<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardMetricLowStock"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/pos_surface_header"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/pos_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="126dp"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/low_stock_items"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
            android:textColor="@color/pos_text_secondary"
            android:textStyle="normal" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivMetricLowStockIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_warning_24"
                app:tint="@color/pos_warning" />

            <TextView
                android:id="@+id/tvMetricLowStockValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textAppearance="@style/TextAppearance.ZejiosCafe.KpiValue"
                android:textColor="@color/pos_warning"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMetricLowStockDelta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:minLines="2"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
            android:textStyle="normal" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
