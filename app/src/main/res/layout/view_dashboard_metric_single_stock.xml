<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/dashboard_metric_low_bg"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/pos_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="148dp"
        android:orientation="vertical"
        android:padding="18dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_inventory_24"
            app:tint="@color/pos_warning" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/low_stock_items"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
            android:textColor="@color/pos_text_secondary"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/tvMetricLowStockValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.KpiValue"
            android:textColor="@color/pos_text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvMetricLowStockDelta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:minLines="2"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
            android:textStyle="normal" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
