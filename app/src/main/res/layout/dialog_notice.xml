<?xml version="1.0" encoding="utf-8"?>
<!--
    Generic notice modal.

    White rounded sheet with a corner close (X), centered tinted-circle
    icon, title, body, and a single primary action button. Shared by
    warning/info messages that previously surfaced as Snackbars.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="360dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_receipt_sheet"
    android:clipToOutline="true"
    android:elevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="32dp"
        android:paddingEnd="28dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:id="@+id/noticeIconWrapper"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_receipt_logo_circle">

            <ImageView
                android:id="@+id/ivNoticeIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_warning_24"
                app:tint="@color/pos_primary_dark" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvNoticeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="@color/pos_text_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Stock limit reached" />

        <TextView
            android:id="@+id/tvNoticeMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/pos_text_secondary"
            android:textSize="14sp"
            tools:text="Only 1 Beef Patty left. It is already reserved by the current order." />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNoticeOk"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/notice_dialog_ok"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/pos_primary"
            app:cornerRadius="14dp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnCloseNotice"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/close_checkout"
        android:padding="6dp"
        android:src="@drawable/ic_close_24"
        app:tint="@color/pos_text_secondary" />
</FrameLayout>
