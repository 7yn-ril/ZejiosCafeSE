<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/staffProfileCardRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/pos_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/pos_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Left accent stripe -->
        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"
            android:background="@color/pos_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Header: avatar + name/ID + role chip on right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:cardBackgroundColor="@color/pos_success_soft"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/pos_secondary"
                    app:strokeWidth="2dp">

                    <TextView
                        android:id="@+id/tvStaffCardInitials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/pos_secondary"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="LA" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStaffName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.Headline"
                        android:textColor="@color/pos_text_primary"
                        tools:text="Luke Arrieta" />

                    <TextView
                        android:id="@+id/tvStaffId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:textColor="@color/pos_text_secondary"
                        android:textSize="13sp"
                        tools:text="ID: #EMP_001" />
                </LinearLayout>
            </LinearLayout>

            <!-- Role chip row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvStaffRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hint_chip"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/pos_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_staff_24"
                    app:drawableTint="@color/pos_secondary"
                    tools:text="Manager" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@color/pos_border" />

            <!-- Actions row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditStaff"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/edit"
                    android:textAllCaps="false"
                    android:textColor="@color/pos_secondary"
                    app:backgroundTint="@color/pos_success_soft"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_edit_18"
                    app:iconPadding="6dp"
                    app:iconTint="@color/pos_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStaffActions"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="44dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:contentDescription="@string/order_actions"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/pos_surface_soft"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_more_vert_24"
                    app:iconTint="@color/pos_text_secondary"
                    app:strokeColor="@color/pos_border"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
