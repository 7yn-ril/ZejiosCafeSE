<?xml version="1.0" encoding="utf-8"?>
<!--
    Profile content (landscape / tablet).
    The page title and subtitle are rendered by the shared MainActivity topBar.
    Nothing in this file should duplicate that title.

    Layout flow, top → bottom:
       1. Hero identity card           (avatar, name, role pill, email, Edit)
       2. Personal Details card        (two-column field grid)
       3. Account Actions card         (Edit Profile, Logout)
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_page_content_shell"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- ─────────────────────────────────────────────────────
             Section A — Hero identity card
             Large avatar tile, name + role pill + email stacked,
             and an inline Edit button on the trailing edge.
             ───────────────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/pos_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/pos_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="22dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    app:cardBackgroundColor="@color/pos_success_soft"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/profile_avatar"
                        android:src="@drawable/ic_staff_24"
                        app:tint="@color/pos_secondary" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfilePageName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_name"
                        android:textColor="@color/pos_text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvProfilePageRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_hint_chip"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:text="@string/profile_role"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
                        android:textColor="@color/pos_secondary" />

                    <TextView
                        android:id="@+id/tvProfilePageEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/profile_email"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                        android:textColor="@color/pos_text_secondary" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditProfileInline"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/edit"
                    android:textAllCaps="false"
                    android:textColor="@color/pos_primary"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_edit_18"
                    app:iconPadding="6dp"
                    app:iconSize="16dp"
                    app:iconTint="@color/pos_primary"
                    app:strokeColor="@color/pos_primary"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─────────────────────────────────────────────────────
             Section B — Personal Details
             Two-column grid: each field is a labelled tile inside
             a soft surface so values are easy to scan. The tiles
             share a row weight so columns line up edge-to-edge.
             ───────────────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_section_gap"
            app:cardBackgroundColor="@color/pos_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/pos_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_details_title"
                    android:textColor="@color/pos_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/profile_details_subtitle"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                    android:textColor="@color/pos_text_secondary" />

                <!-- Row 1 — Email | Phone -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_profile_card_compact"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_field_email"
                            android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                            android:textColor="@color/pos_text_secondary" />

                        <TextView
                            android:id="@+id/tvProfilePageEmailDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/profile_email"
                            android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                            android:textColor="@color/pos_text_primary"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Space
                        android:layout_width="@dimen/content_inline_gap"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_profile_card_compact"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_field_phone"
                            android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                            android:textColor="@color/pos_text_secondary" />

                        <TextView
                            android:id="@+id/tvProfilePagePhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/profile_phone_value"
                            android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                            android:textColor="@color/pos_text_primary"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Row 2 — Address | Role -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/content_inline_gap"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_profile_card_compact"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_field_address"
                            android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                            android:textColor="@color/pos_text_secondary" />

                        <TextView
                            android:id="@+id/tvProfilePageAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/profile_address_value"
                            android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                            android:textColor="@color/pos_text_primary"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Space
                        android:layout_width="@dimen/content_inline_gap"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_profile_card_compact"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/profile_field_role"
                            android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                            android:textColor="@color/pos_text_secondary" />

                        <TextView
                            android:id="@+id/tvProfilePageRoleDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/profile_role"
                            android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                            android:textColor="@color/pos_text_primary"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─────────────────────────────────────────────────────
             Section C — Account actions
             Edit and Logout sit side-by-side as equal columns so the
             card has a balanced footprint. Same heights / radii as
             other primary CTAs across the app.
             ───────────────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_section_gap"
            app:cardBackgroundColor="@color/pos_surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/pos_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/profile_actions_title"
                    android:textColor="@color/pos_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/profile_actions_subtitle"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                    android:textColor="@color/pos_text_secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEditProfile"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/profile_edit_action"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/pos_secondary"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_edit_18"
                        app:iconPadding="6dp"
                        app:iconTint="@color/white" />

                    <Space
                        android:layout_width="@dimen/content_inline_gap"
                        android:layout_height="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogoutProfile"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/logout"
                        android:textAllCaps="false"
                        app:backgroundTint="@color/pos_badge"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_close_24"
                        app:iconPadding="6dp"
                        app:iconTint="@color/white" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
