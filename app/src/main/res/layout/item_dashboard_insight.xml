<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/pos_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:minHeight="144dp"
        android:padding="16dp">

        <View
            android:layout_width="34dp"
            android:layout_height="4dp"
            android:background="@drawable/bg_hint_chip"
            android:backgroundTint="@color/pos_secondary" />

        <TextView
            android:id="@+id/tvInsightTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
            android:textColor="@color/pos_text_secondary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvInsightValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.Headline"
            android:textColor="@color/pos_text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvInsightSupporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
            android:textColor="@color/pos_text_secondary"
            android:textStyle="normal" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
