<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/content_inline_gap"
    app:cardBackgroundColor="@color/pos_surface_soft"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/pos_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvInsightTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
            android:textColor="@color/pos_text_secondary"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/tvInsightValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.Headline"
            android:textColor="@color/pos_text_primary"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/tvInsightSupporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
            android:textColor="@color/pos_text_secondary"
            android:textStyle="normal" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
