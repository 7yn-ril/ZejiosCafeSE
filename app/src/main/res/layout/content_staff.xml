<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:padding="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_page_content_shell"
        android:orientation="vertical"
        android:padding="22dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/pos_surface"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStaffPageTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/staff_management_title"
                        android:textColor="@color/pos_text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvStaffPageSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/staff_management_subtitle"
                        android:textColor="@color/pos_text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddStaff"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="@string/add_staff"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    app:backgroundTint="@color/pos_secondary"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_add_18"
                    app:iconSize="16dp"
                    app:iconPadding="6dp"
                    app:iconTint="@color/white" />

                <FrameLayout
                    android:id="@+id/staffNotificationFrame"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_notification_container">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/notifications"
                        android:src="@drawable/ic_notification_24"
                        app:tint="@color/pos_text_secondary" />

                    <TextView
                        android:id="@+id/tvStaffNotificationBadge"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="end|top"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="2dp"
                        android:background="@drawable/bg_notification_badge"
                        android:gravity="center"
                        android:text="@string/notification_count"
                        android:textColor="@color/white"
                        android:textSize="9sp"
                        android:textStyle="bold" />
                </FrameLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_section_gap"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/pos_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/pos_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        app:cardBackgroundColor="@color/pos_success_soft"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/total_staff"
                            android:src="@drawable/ic_staff_24"
                            app:tint="@color/pos_secondary" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvStaffMetricTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/staff_metric_total_value"
                        android:textColor="@color/pos_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_staff"
                        android:textColor="@color/pos_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/content_inline_gap"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/pos_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/pos_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        app:cardBackgroundColor="@color/pos_success_soft"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/active_today"
                            android:src="@drawable/ic_staff_24"
                            app:tint="@color/pos_secondary" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvStaffMetricActive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/staff_metric_active_value"
                        android:textColor="@color/pos_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/active_today"
                        android:textColor="@color/pos_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/content_inline_gap"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/pos_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/pos_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        app:cardBackgroundColor="@color/pos_warning_soft"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/on_break"
                            android:src="@drawable/ic_clock_24"
                            app:tint="@color/pos_warning" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvStaffMetricBreak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/staff_metric_break_value"
                        android:textColor="@color/pos_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/on_break"
                        android:textColor="@color/pos_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/content_inline_gap"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/pos_surface"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/pos_border"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        app:cardBackgroundColor="@color/pos_critical_soft"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/off_duty"
                            android:src="@drawable/ic_warning_24"
                            app:tint="@color/pos_badge" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvStaffMetricOff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="@string/staff_metric_off_value"
                        android:textColor="@color/pos_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/off_duty"
                        android:textColor="@color/pos_text_secondary"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_section_gap"
            app:cardBackgroundColor="@color/pos_surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/pos_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:hint="@string/staff_search_hint"
                    app:boxBackgroundColor="@color/pos_surface_soft"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/pos_border"
                    app:startIconDrawable="@drawable/ic_search_24"
                    app:startIconTint="@color/pos_text_secondary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStaffSearch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStaffRoleFilter"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginStart="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="@string/all_roles"
                    android:textAllCaps="false"
                    android:textColor="@color/pos_text_primary"
                    app:backgroundTint="@color/pos_surface"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_expand_more_24"
                    app:iconGravity="textEnd"
                    app:iconPadding="8dp"
                    app:iconTint="@color/pos_text_primary"
                    app:strokeColor="@color/pos_border"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnStaffStatusFilter"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginStart="10dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="@string/all_status"
                    android:textAllCaps="false"
                    android:textColor="@color/pos_text_primary"
                    app:backgroundTint="@color/pos_surface"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_expand_more_24"
                    app:iconGravity="textEnd"
                    app:iconPadding="8dp"
                    app:iconTint="@color/pos_text_primary"
                    app:strokeColor="@color/pos_border"
                    app:strokeWidth="1dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_section_gap"
            android:clipToPadding="false"
            android:paddingEnd="72dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/staffCardsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStaffOne"
                    android:layout_width="360dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/content_inline_gap"
                    app:cardBackgroundColor="@color/pos_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/pos_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                app:cardBackgroundColor="@color/pos_success_soft"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@string/staff_member_avatar"
                                    android:src="@drawable/ic_staff_24"
                                    app:tint="@color/pos_secondary" />
                            </com.google.android.material.card.MaterialCardView>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvStaffNameOne"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/staff_member_name_one"
                                    android:textAppearance="@style/TextAppearance.ZejiosCafe.Headline"
                                    android:textColor="@color/pos_text_primary" />

                                <TextView
                                    android:id="@+id/tvStaffIdOne"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/staff_member_id_one"
                                    android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyLarge"
                                    android:textColor="@color/pos_text_secondary" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvStaffStatusOne"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_stock_badge"
                                android:paddingStart="12dp"
                                android:paddingTop="5dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="5dp"
                                android:text="@string/staff_status_active"
                                android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyLarge"
                                android:textColor="@color/white" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvStaffRoleOne"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_hint_chip"
                                android:paddingStart="10dp"
                                android:paddingTop="5dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="5dp"
                                android:text="@string/staff_role_manager"
                                android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyLarge"
                                android:textColor="@color/pos_secondary" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="10dp"
                                android:contentDescription="@string/shift_time"
                                android:src="@drawable/ic_clock_24"
                                app:tint="@color/pos_text_secondary" />

                            <TextView
                                android:id="@+id/tvStaffShiftOne"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/staff_shift_one"
                                android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyLarge"
                                android:textColor="@color/pos_text_secondary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEditStaffOne"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="0dp"
                                android:layout_height="42dp"
                                android:layout_weight="1"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="@string/edit"
                                android:textAllCaps="false"
                                app:backgroundTint="@color/pos_secondary"
                                app:cornerRadius="12dp"
                                app:icon="@drawable/ic_edit_18"
                                app:iconPadding="6dp"
                                app:iconTint="@color/white" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnStaffActionsOne"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="44dp"
                                android:layout_height="42dp"
                                android:layout_marginStart="8dp"
                                android:contentDescription="@string/order_actions"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                app:backgroundTint="@color/pos_surface_soft"
                                app:cornerRadius="12dp"
                                app:icon="@drawable/ic_more_vert_24"
                                app:iconTint="@color/pos_text_secondary"
                                app:strokeColor="@color/pos_border"
                                app:strokeWidth="1dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardStaffTwo"
                    android:layout_width="360dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/content_inline_gap"
                    app:cardBackgroundColor="@color/pos_surface"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/pos_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                app:cardBackgroundColor="@color/pos_info_soft"
                                app:cardCornerRadius="14dp"
                                app:cardElevation="0dp">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:layout_gravity="center"
                                    android:contentDescription="@string/staff_member_avatar"
                                    android:src="@drawable/ic_staff_24"
                                    app:tint="@color/pos_info" />
                            </com.google.android.material.card.MaterialCardView>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvStaffNameTwo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/staff_member_name_two"
                                    android:textAppearance="@style/TextAppearance.ZejiosCafe.Headline"
                                    android:textColor="@color/pos_text_primary" />

                                <TextView
                                    android:id="@+id/tvStaffIdTwo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/staff_member_id_two"
                                    android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyLarge"
                                    android:textColor="@color/pos_text_secondary" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvStaffStatusTwo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_stock_badge"
                                android:paddingStart="12dp"
                                android:paddingTop="5dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="5dp"
                                android:text="@string/staff_status_active"
                                android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyLarge"
                                android:textColor="@color/white" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvStaffRoleTwo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_hint_chip"
                                android:paddingStart="10dp"
                                android:paddingTop="5dp"
                                android:paddingEnd="10dp"
                                android:paddingBottom="5dp"
                                android:text="@string/staff_role_barista"
                                android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyLarge"
                                android:textColor="@color/pos_secondary" />

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:layout_marginStart="10dp"
                                android:contentDescription="@string/shift_time"
                                android:src="@drawable/ic_clock_24"
                                app:tint="@color/pos_text_secondary" />

                            <TextView
                                android:id="@+id/tvStaffShiftTwo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/staff_shift_two"
                                android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyLarge"
                                android:textColor="@color/pos_text_secondary" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnEditStaffTwo"
                                style="@style/Widget.Material3.Button"
                                android:layout_width="0dp"
                                android:layout_height="42dp"
                                android:layout_weight="1"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:text="@string/edit"
