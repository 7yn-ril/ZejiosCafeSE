<?xml version="1.0" encoding="utf-8"?>
<!--
    Staff content (landscape / tablet).
    The page title and subtitle are rendered by the shared MainActivity topBar
    (Dashboard / POS / Orders / Inventory / Staff share that header). Nothing in
    this file should duplicate that title.

    Layout flow, top → bottom:
       1. KPI metric tiles            (Total / Active / Break / Off-duty)
       2. Action bar                  (search + role filter + status filter + Add Staff)
       3. Staff card grid             (3 columns, fixed-width grid — not horizontally scrollable)
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_page_content_shell"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- ─────────────────────────────────────────────────────
             Section A — Team banner (Total Staff hero card)
             ───────────────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/pos_surface"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/pos_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="18dp"
                android:paddingEnd="20dp"
                android:paddingBottom="18dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:cardBackgroundColor="@color/pos_success_soft"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/total_staff"
                        android:src="@drawable/ic_staff_24"
                        app:tint="@color/pos_secondary" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/total_staff"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
                        android:textColor="@color/pos_text_secondary" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:baselineAligned="true"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvStaffMetricTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/staff_metric_total_value"
                            android:textColor="@color/pos_text_primary"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:layout_marginStart="6dp"
                            android:layout_marginBottom="4dp"
                            android:text="@string/staff_banner_members_label"
                            android:textColor="@color/pos_text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hint_chip"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:text="@string/staff_banner_roster_label"
                    android:textColor="@color/pos_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ─────────────────────────────────────────────────────
             Section B — Action bar (search + filters + Add Staff)
             Mirrors the Orders / Inventory action bar pattern so the
             toolbar feels consistent across pages. All controls share
             the same height so their top/bottom edges line up.
             ───────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_section_gap"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="@dimen/search_height"
                android:layout_weight="1"
                android:hint="@string/staff_search_hint"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusTopStart="18dp"
                app:boxStrokeColor="@color/pos_border"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:startIconDrawable="@drawable/ic_search_24"
                app:startIconTint="@color/pos_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etStaffSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/pos_text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStaffRoleFilter"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/search_height"
                android:layout_marginStart="12dp"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:minWidth="134dp"
                android:text="@string/all_roles"
                android:textAllCaps="false"
                android:textColor="@color/pos_primary"
                android:textSize="12sp"
                app:backgroundTint="@color/white"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_expand_more_24"
                app:iconGravity="textEnd"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="@color/pos_primary"
                app:strokeColor="@color/pos_primary"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddStaff"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/search_height"
                android:layout_marginStart="10dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/add_staff"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:backgroundTint="@color/pos_secondary"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_add_18"
                app:iconPadding="6dp"
                app:iconSize="16dp"
                app:iconTint="@color/white" />
        </LinearLayout>

        <!-- ─────────────────────────────────────────────────────
             Section C — Staff card grid
             Cards are added dynamically by MainActivity.addStaffCard().
             The GridLayout wraps cards into rows of three.
             ───────────────────────────────────────────────────── -->
        <TextView
            android:id="@+id/tvStaffEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_section_gap"
            android:gravity="center"
            android:paddingTop="32dp"
            android:paddingBottom="32dp"
            android:text="@string/staff_empty_state"
            android:textColor="@color/pos_text_secondary"
            android:textSize="14sp"
            android:visibility="visible" />

        <LinearLayout
            android:id="@+id/staffCardsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_section_gap"
            android:orientation="vertical" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
