<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="26dp"
    app:cardElevation="0dp"
    app:strokeColor="@android:color/transparent"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dashboard_profit_panel"
        android:minHeight="156dp"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_dashboard_24"
            app:tint="@color/pos_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/metric_net_profit"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
            android:textColor="@color/pos_text_secondary"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/tvMetricProfitValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.KpiValue"
            android:textColor="@color/pos_text_primary"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/tvMetricProfitDelta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
            android:textStyle="normal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/dashboard_profit_pulse_caption"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
            android:textColor="@color/pos_text_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
