<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/pos_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Row 1: thumbnail + name/unit + line total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivOrderItem"
                android:layout_width="@dimen/order_item_thumbnail_size"
                android:layout_height="@dimen/order_item_thumbnail_size"
                android:background="@drawable/bg_product_placeholder"
                android:contentDescription="@string/order_item_thumbnail"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.ZejiosCafe.Thumbnail"
                tools:src="@drawable/ic_coffee_24" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/content_inline_gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOrderItemName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/pos_text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Aloha Fruit Punch" />

                <TextView
                    android:id="@+id/tvOrderItemUnitPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:textColor="@color/pos_text_secondary"
                    android:textSize="11sp"
                    tools:text="PHP 141.75 each" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvOrderItemPrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/pos_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="PHP 141.75" />
        </LinearLayout>

        <!-- Row 2: full-width stepper at the bottom of the card -->
        <LinearLayout
            android:id="@+id/orderQuantityContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_cart_stepper"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="4dp">

            <ImageButton
                android:id="@+id/btnOrderItemDecrease"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_stepper_decrease"
                android:contentDescription="@string/decrease_quantity"
                android:padding="0dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_remove_18"
                app:tint="@color/pos_primary" />

            <TextView
                android:id="@+id/tvOrderItemQty"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/pos_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="1" />

            <ImageButton
                android:id="@+id/btnOrderItemIncrease"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_stepper_increase"
                android:contentDescription="@string/increase_quantity"
                android:padding="0dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_add_18"
                app:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
