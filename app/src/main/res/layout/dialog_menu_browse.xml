<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pos_surface">

    <!-- Header: title + close button -->
    <TextView
        android:id="@+id/tvModalTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/content_panel_padding"
        android:layout_marginTop="20dp"
        android:textAppearance="@style/TextAppearance.ZejiosCafe.Title"
        android:textColor="@color/pos_text_primary"
        app:layout_constraintEnd_toStartOf="@id/btnCloseModal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Browse Categories" />

    <TextView
        android:id="@+id/tvModalSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/content_panel_padding"
        android:layout_marginTop="2dp"
        android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
        android:textColor="@color/pos_text_secondary"
        app:layout_constraintEnd_toStartOf="@id/btnCloseModal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvModalTitle"
        tools:text="Tap a category to filter the menu" />

    <ImageButton
        android:id="@+id/btnCloseModal"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/close_checkout"
        android:padding="10dp"
        android:src="@drawable/ic_close_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/pos_text_secondary" />

    <!-- Divider -->
    <View
        android:id="@+id/headerDivider"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/pos_divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvModalSubtitle" />

    <!-- Category cards in a 2-column grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvModalCategories"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="@dimen/content_panel_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerDivider"
        tools:listitem="@layout/item_category_picker" />

</androidx.constraintlayout.widget.ConstraintLayout>
