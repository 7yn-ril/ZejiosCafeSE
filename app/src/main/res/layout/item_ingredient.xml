<?xml version="1.0" encoding="utf-8"?>
<!--
    UI CHANGE: Single horizontal table row to match the reference inventory
    design. Column weights mirror the header in fragment_inventory.xml so
    headers and cells line up. paddingEnd on each cell provides the gutter
    between columns; text sizes are tuned for breathing room over density.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:baselineAligned="false"
    android:gravity="center_vertical"
    android:minHeight="72dp"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="20dp"
    android:paddingBottom="18dp">

    <!-- Product Name -->
    <TextView
        android:id="@+id/tvIngredientName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.4"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingEnd="16dp"
        android:textColor="@color/pos_text_primary"
        android:textSize="13sp"
        android:textStyle="bold"
        tools:text="Espresso Beans" />

    <!-- Category -->
    <TextView
        android:id="@+id/tvIngredientCategory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.6"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingEnd="16dp"
        android:textColor="@color/pos_text_secondary"
        android:textSize="12sp"
        tools:text="Coffee" />

    <!-- Current Stock — always rendered as "{N} piece" by the adapter. -->
    <TextView
        android:id="@+id/tvCurrentStock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.2"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingEnd="16dp"
        android:textColor="@color/pos_text_primary"
        android:textSize="12sp"
        tools:text="42 piece" />

    <!-- Amount per Serving — always rendered as "{N} piece". -->
    <TextView
        android:id="@+id/tvServings"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingEnd="16dp"
        android:textColor="@color/pos_text_primary"
        android:textSize="12sp"
        tools:text="1 piece" />

    <!-- Price per Piece -->
    <TextView
        android:id="@+id/tvCostPerUnit"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingEnd="16dp"
        android:textColor="@color/pos_text_primary"
        android:textSize="12sp"
        tools:text="PHP 25.00" />

    <!-- Total Value -->
    <TextView
        android:id="@+id/tvTotalValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.6"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingEnd="16dp"
        android:textColor="@color/pos_secondary"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="PHP 1,050.00" />

    <!-- Stock Level badge: green "In Stock" / red "Low Stock" pill,
         swapped by the adapter at the ≤10-servings boundary. -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.6"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/tvStockStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_in_stock"
            android:ellipsize="end"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minWidth="96dp"
            android:paddingStart="12dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:textColor="@color/stock_good"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="• In Stock" />
    </FrameLayout>

    <!-- UI CHANGE: Edit / Restock collapsed into a kebab menu so the row
         keeps room for the wider Total Value column. The PopupMenu is
         inflated by IngredientAdapter and dispatches to the same callbacks. -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.5"
        android:gravity="end">

        <ImageButton
            android:id="@+id/btnRowActions"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Row actions"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more_vert_24"
            app:tint="@color/pos_text_secondary" />
    </FrameLayout>

    <!-- Hidden anchors so legacy findViewById bindings stay valid. -->
    <View
        android:id="@+id/stockBarTrack"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <View
        android:id="@+id/stockBarFill"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />
</LinearLayout>
