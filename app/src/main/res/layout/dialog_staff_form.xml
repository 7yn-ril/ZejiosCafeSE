<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/staffDialogScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <!-- Header — avatar preview + title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    app:cardBackgroundColor="@color/pos_success_soft"
                    app:cardCornerRadius="28dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/pos_secondary"
                    app:strokeWidth="2dp">

                    <TextView
                        android:id="@+id/tvStaffDialogInitials"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textColor="@color/pos_secondary"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="LA" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvStaffDialogTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.Headline"
                        android:textColor="@color/pos_text_primary"
                        tools:text="Add Staff Member" />

                    <TextView
                        android:id="@+id/tvStaffDialogSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
                        android:textColor="@color/pos_text_secondary"
                        tools:text="Onboard a new team member" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="@color/pos_border" />

        <!-- Employee ID badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/staff_field_employee_id"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
            android:textColor="@color/pos_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_hint_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/staff_field_employee_id"
                android:src="@drawable/ic_staff_24"
                app:tint="@color/pos_secondary" />

            <TextView
                android:id="@+id/tvStaffDialogEmployeeId"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="monospace"
                android:textColor="@color/pos_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="#EMP_001" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/staff_auto_id_label"
                android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
                android:textColor="@color/pos_secondary" />
        </LinearLayout>

        <!-- Full Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilStaffDialogName"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/staff_field_full_name"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/pos_border"
            app:hintTextColor="@color/pos_secondary"
            app:startIconDrawable="@drawable/ic_staff_24"
            app:startIconTint="@color/pos_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStaffDialogName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:textColor="@color/pos_text_primary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Role dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilStaffDialogRole"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/staff_field_role"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/pos_border"
            app:hintTextColor="@color/pos_secondary"
            app:startIconDrawable="@drawable/ic_staff_24"
            app:startIconTint="@color/pos_text_secondary">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actvStaffDialogRole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/pos_text_primary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Email -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilStaffDialogEmail"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/staff_field_email"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/pos_border"
            app:hintTextColor="@color/pos_secondary"
            app:startIconDrawable="@drawable/ic_staff_24"
            app:startIconTint="@color/pos_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStaffDialogEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:textColor="@color/pos_text_primary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Phone -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilStaffDialogPhone"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/staff_field_phone"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/pos_border"
            app:hintTextColor="@color/pos_secondary"
            app:startIconDrawable="@drawable/ic_staff_24"
            app:startIconTint="@color/pos_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStaffDialogPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:textColor="@color/pos_text_primary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── Personal details section ───────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/staff_section_personal"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
            android:textColor="@color/pos_text_secondary" />

        <!-- Address -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilStaffDialogAddress"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/staff_field_address"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/pos_border"
            app:hintTextColor="@color/pos_secondary"
            app:startIconDrawable="@drawable/ic_staff_24"
            app:startIconTint="@color/pos_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStaffDialogAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPostalAddress|textCapWords"
                android:maxLines="2"
                android:textColor="@color/pos_text_primary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Birthdate (tap to open date picker — see MainActivity) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilStaffDialogBirthdate"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/staff_field_birthdate"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/pos_border"
            app:endIconMode="clear_text"
            app:hintTextColor="@color/pos_secondary"
            app:startIconDrawable="@drawable/ic_clock_24"
            app:startIconTint="@color/pos_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStaffDialogBirthdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:cursorVisible="false"
                android:focusable="false"
                android:inputType="none"
                android:longClickable="false"
                android:textColor="@color/pos_text_primary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Gender dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilStaffDialogGender"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/staff_field_gender"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/pos_border"
            app:hintTextColor="@color/pos_secondary"
            app:startIconDrawable="@drawable/ic_staff_24"
            app:startIconTint="@color/pos_text_secondary">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actvStaffDialogGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/pos_text_primary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── Emergency contact section ──────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/staff_section_emergency"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
            android:textColor="@color/pos_text_secondary" />

        <!-- Emergency contact name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilStaffDialogEmergencyName"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/staff_field_emergency_name"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/pos_border"
            app:hintTextColor="@color/pos_secondary"
            app:startIconDrawable="@drawable/ic_staff_24"
            app:startIconTint="@color/pos_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStaffDialogEmergencyName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords"
                android:textColor="@color/pos_text_primary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Emergency contact phone -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilStaffDialogEmergencyPhone"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/staff_field_emergency_phone"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/pos_border"
            app:hintTextColor="@color/pos_secondary"
            app:startIconDrawable="@drawable/ic_staff_24"
            app:startIconTint="@color/pos_text_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etStaffDialogEmergencyPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:textColor="@color/pos_text_primary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Emergency contact relationship -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilStaffDialogEmergencyRelationship"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/staff_field_emergency_relationship"
            app:boxBackgroundColor="@color/white"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusTopStart="12dp"
            app:boxStrokeColor="@color/pos_border"
            app:hintTextColor="@color/pos_secondary"
            app:startIconDrawable="@drawable/ic_staff_24"
            app:startIconTint="@color/pos_text_secondary">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/actvStaffDialogEmergencyRelationship"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text|textCapWords"
                android:textColor="@color/pos_text_primary"
                android:textSize="15sp" />
        </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/pos_border" />

    <LinearLayout
        android:id="@+id/staffDialogActionBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical|end"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="14dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStaffDialogCancel"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="104dp"
            android:layout_height="44dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@android:string/cancel"
            android:textAllCaps="false"
            android:textColor="@color/pos_primary"
            android:textSize="13sp"
            app:backgroundTint="@color/white"
            app:cornerRadius="10dp"
            app:strokeColor="@color/pos_primary"
            app:strokeWidth="1dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStaffDialogSave"
            style="@style/Widget.Material3.Button.UnelevatedButton"
            android:layout_width="104dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="@string/staff_dialog_save_action"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="@color/pos_secondary"
            app:cornerRadius="10dp" />
    </LinearLayout>
</LinearLayout>
