<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_canvas"
    tools:context=".MainActivity">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/sidebarContainer"
        android:layout_width="@dimen/sidebar_expanded_width"
        android:layout_height="0dp"
        android:layout_margin="@dimen/screen_padding"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/sidebarSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_sidebar_surface"
            android:orientation="vertical"
            android:padding="@dimen/sidebar_padding">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/sidebarHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/ivSidebarLogo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_sidebar_logo_circle"
                    android:contentDescription="@string/app_name"
                    android:padding="4dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_pos_24"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:tint="@color/pos_sidebar_bg" />

                <LinearLayout
                    android:id="@+id/sidebarHeaderTextContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toStartOf="@id/btnToggleSidebar"
                    app:layout_constraintStart_toEndOf="@id/ivSidebarLogo"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent">

                    <TextView
                        android:id="@+id/tvSidebarTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/sidebar_cafe_name"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.SidebarTitle"
                        android:textColor="@color/white"
                        android:textStyle="normal" />

                    <TextView
                        android:id="@+id/tvSidebarSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/sidebar_cafe_subtitle"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
                        android:textColor="@color/pos_text_on_sidebar_muted"
                        android:textStyle="normal" />
                </LinearLayout>

                <View
                    android:id="@+id/sidebarHeaderTapArea"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:background="@android:color/transparent"
                    android:clickable="false"
                    android:focusable="false"
                    android:importantForAccessibility="no"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageButton
                    android:id="@+id/btnToggleSidebar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/toggle_sidebar"
                    android:src="@drawable/ic_expand_more_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/white" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/sidebarHeaderDivider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:background="@color/pos_divider"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="20dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Main navigation group -->
                <LinearLayout
                    android:id="@+id/itemDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sidebar_item_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ivSidebarDashboard"
                        android:layout_width="@dimen/sidebar_icon_size"
                        android:layout_height="@dimen/sidebar_icon_size"
                        android:src="@drawable/ic_dashboard_24"
                        app:tint="@color/pos_text_on_sidebar" />

                    <TextView
                        android:id="@+id/tvSidebarDashboard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/dashboard"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.SidebarItem"
                        android:textColor="@color/pos_text_on_sidebar"
                        android:textStyle="normal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/itemPos"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sidebar_item_height"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_sidebar_item_selected"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ivSidebarPos"
                        android:layout_width="@dimen/sidebar_icon_size"
                        android:layout_height="@dimen/sidebar_icon_size"
                        android:src="@drawable/ic_pos_24"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tvSidebarPos"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/pos"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.SidebarItem"
                        android:textColor="@color/white"
                        android:textStyle="normal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/itemOrders"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sidebar_item_height"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ivSidebarOrders"
                        android:layout_width="@dimen/sidebar_icon_size"
                        android:layout_height="@dimen/sidebar_icon_size"
                        android:src="@drawable/ic_orders_24"
                        app:tint="@color/pos_text_on_sidebar" />

                    <TextView
                        android:id="@+id/tvSidebarOrders"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/orders"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.SidebarItem"
                        android:textColor="@color/pos_text_on_sidebar"
                        android:textStyle="normal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/itemInventory"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sidebar_item_height"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ivSidebarInventory"
                        android:layout_width="@dimen/sidebar_icon_size"
                        android:layout_height="@dimen/sidebar_icon_size"
                        android:src="@drawable/ic_inventory_filled_24"
                        app:tint="@color/pos_text_on_sidebar" />

                    <TextView
                        android:id="@+id/tvSidebarInventory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/inventory"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.SidebarItem"
                        android:textColor="@color/pos_text_on_sidebar"
                        android:textStyle="normal" />
                </LinearLayout>

                <!-- Divider between nav groups -->
                <View
                    android:id="@+id/sidebarSectionDivider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="@color/pos_divider" />

                <LinearLayout
                    android:id="@+id/itemReports"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sidebar_item_height"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ivSidebarReports"
                        android:layout_width="@dimen/sidebar_icon_size"
                        android:layout_height="@dimen/sidebar_icon_size"
                        android:src="@drawable/ic_reports_24"
                        app:tint="@color/pos_text_on_sidebar" />

                    <TextView
                        android:id="@+id/tvSidebarReports"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/reports"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.SidebarItem"
                        android:textColor="@color/pos_text_on_sidebar"
                        android:textStyle="normal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/itemStaff"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sidebar_item_height"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ivSidebarStaff"
                        android:layout_width="@dimen/sidebar_icon_size"
                        android:layout_height="@dimen/sidebar_icon_size"
                        android:src="@drawable/ic_staff_24"
                        app:tint="@color/pos_text_on_sidebar" />

                    <TextView
                        android:id="@+id/tvSidebarStaff"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/staff"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.SidebarItem"
                        android:textColor="@color/pos_text_on_sidebar"
                        android:textStyle="normal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/itemSettings"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sidebar_item_height"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivSidebarSettings"
                        android:layout_width="@dimen/sidebar_icon_size"
                        android:layout_height="@dimen/sidebar_icon_size"
                        android:src="@drawable/ic_settings_24"
                        app:tint="@color/pos_text_on_sidebar" />

                    <TextView
                        android:id="@+id/tvSidebarSettings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/settings"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.SidebarItem"
                        android:textColor="@color/pos_text_on_sidebar"
                        android:textStyle="normal" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/profileCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/ivProfileAvatar"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:contentDescription="@string/profile_name"
                    android:padding="7dp"
                    android:src="@drawable/ic_staff_24"
                    app:tint="@color/pos_primary" />

                <LinearLayout
                    android:id="@+id/profileTextContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_name"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                        android:textColor="@color/white"
                        android:textStyle="normal" />

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/profile_email"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
                        android:textColor="@color/pos_text_on_sidebar_muted"
                        android:textStyle="normal" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/main_content_gap_expanded"
        android:layout_marginTop="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/screen_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/sidebarContainer"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Header bar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/pos_surface_header"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/pos_border"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/section_spacing">

                <LinearLayout
                    android:id="@+id/topTitleContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginEnd="14dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="@id/topBarActions"
                    app:layout_constraintEnd_toStartOf="@id/topBarActions"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/topBarActions">

                    <TextView
                        android:id="@+id/tvTopTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/pos_title"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.Title"
                        android:textColor="@color/pos_text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTopSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:text="@string/pos_subtitle"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                        android:textColor="@color/pos_text_secondary"
                        android:textStyle="normal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/topBarActions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <FrameLayout
                        android:id="@+id/notificationFrame"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_notification_container">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center"
                            android:contentDescription="@string/notifications"
                            android:src="@drawable/ic_notification_24"
                            app:tint="@color/pos_primary" />

                        <TextView
                            android:id="@+id/tvNotificationBadge"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_gravity="end|top"
                            android:layout_marginTop="2dp"
                            android:layout_marginEnd="2dp"
                            android:background="@drawable/bg_notification_badge"
                            android:gravity="center"
                            android:text="@string/notification_count"
                            android:textColor="@color/white"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/topProfileCluster"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/avatar"
                            android:layout_width="@dimen/topbar_avatar_size"
                            android:layout_height="@dimen/topbar_avatar_size"
                            android:background="@drawable/bg_avatar_circle"
                            android:contentDescription="@string/profile_name"
                            android:padding="8dp"
                            android:src="@drawable/ic_staff_24"
                            app:tint="@color/pos_primary" />

                        <LinearLayout
                            android:id="@+id/topProfileTextContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvTopProfileName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:text="@string/profile_name"
                                android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                                android:textColor="@color/pos_text_primary"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTopProfileEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:maxLines="1"
                                android:text="@string/profile_email"
                                android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
                                android:textColor="@color/pos_text_secondary"
                                android:textStyle="normal" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <include
            android:id="@+id/dashboardContent"
            layout="@layout/content_dashboard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/section_spacing"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar" />

        <include
            android:id="@+id/ordersContent"
            layout="@layout/content_orders"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/section_spacing"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar" />

        <include
            android:id="@+id/staffContent"
            layout="@layout/content_staff"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/profileContent"
            layout="@layout/content_profile"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/section_spacing"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar" />

        <include
            android:id="@+id/placeholderContent"
            layout="@layout/content_placeholder"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/section_spacing"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/contentGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.70" />

        <!-- Left panel: search + categories + products -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/leftPanel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/section_spacing"
            android:background="@drawable/bg_page_content_shell"
            android:padding="@dimen/section_spacing"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/contentGuide"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <!-- Search bar with rounded corners and stroke -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/searchInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="@dimen/search_height"
                android:layout_marginEnd="@dimen/content_inline_gap"
                android:hint="@string/search_hint"
                app:boxBackgroundColor="@color/pos_surface_header"
                app:boxCornerRadiusBottomEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusTopStart="18dp"
                app:boxStrokeColor="@color/pos_border"
                app:layout_constraintEnd_toStartOf="@+id/btnFilterSort"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:startIconDrawable="@drawable/ic_search_24"
                app:startIconTint="@color/pos_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterSort"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/search_height"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/filter_sort"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:minWidth="134dp"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="@color/pos_text_primary"
                app:backgroundTint="@color/pos_surface_header"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_filter_24"
                app:iconGravity="textStart"
                app:iconSize="16dp"
                app:iconPadding="4dp"
                app:iconTint="@color/pos_primary"
                app:layout_constraintBottom_toBottomOf="@id/searchInputLayout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/searchInputLayout"
                app:strokeColor="@color/pos_border"
                app:strokeWidth="1dp" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/categoryContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/content_inline_gap"
                android:background="@drawable/bg_category_strip"
                android:padding="6dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/searchInputLayout">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategories"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/category_tab_height"
                    android:clipToPadding="false"
                    android:paddingEnd="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/btnBrowseMenu"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:listitem="@layout/item_category_tab" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBrowseMenu"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="@dimen/category_tab_height"
                    android:layout_height="@dimen/category_tab_height"
                    android:contentDescription="@string/toggle_categories"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    app:backgroundTint="@color/pos_primary"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_expand_more_24"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/white"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProducts"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/section_spacing"
                android:clipToPadding="false"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:paddingBottom="12dp"
                app:layout_constraintBottom_toTopOf="@id/productPaginationContainer"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/categoryContainer"
                tools:listitem="@layout/item_product" />

            <LinearLayout
                android:id="@+id/productPaginationContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPreviousProductsPage"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/pagination_previous"
                    android:textAllCaps="false"
                    app:cornerRadius="14dp" />

                <TextView
                    android:id="@+id/tvProductsPageInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/pos_text_secondary"
                    android:textSize="13sp"
                    tools:text="Page 1 of 3" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextProductsPage"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="@string/pagination_next"
                    android:textAllCaps="false"
                    app:cornerRadius="14dp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Right panel: Current Order -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/rightPanel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/section_spacing"
            android:layout_marginTop="@dimen/section_spacing"
            app:cardBackgroundColor="@color/pos_surface_header"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/contentGuide"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:strokeColor="@color/pos_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="44dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/current_order"
                            android:textAppearance="@style/TextAppearance.ZejiosCafe.Headline"
                            android:textColor="@color/pos_text_primary"
                            android:textStyle="normal" />

                        <TextView
                            android:id="@+id/tvOrderNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
                            android:textColor="@color/pos_text_secondary"
                            android:textStyle="normal"
                            tools:text="Order #POS-1452" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnCloseCheckout"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="top|end"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/close_checkout"
                        android:padding="6dp"
                        android:src="@drawable/ic_close_24"
                        app:tint="@color/pos_text_secondary" />
                </FrameLayout>

                <!-- Order type segment control (Dine In / Take Away) -->
                <LinearLayout
                    android:id="@+id/orderTypeSegment"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_segment_container"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <TextView
                        android:id="@+id/btnOrderTypeDineIn"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_segment_selected"
                        android:gravity="center"
                        android:text="@string/dine_in"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnOrderTypeTakeAway"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_segment_unselected"
                        android:gravity="center"
                        android:text="@string/take_out"
                        android:textColor="@color/pos_text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/emptyOrderState"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="12dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:src="@drawable/ic_cart_empty_24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/no_items_added"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyLarge"
                        android:textColor="@color/pos_text_secondary"
                        android:textStyle="normal" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvOrderItems"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="10dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="4dp"
                    android:visibility="gone"
                    tools:listitem="@layout/item_order" />

                <!-- Divider above Clear + Checkout buttons -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/content_inline_gap"
                    android:layout_marginBottom="@dimen/content_inline_gap"
                    android:background="@color/pos_divider" />

                <!-- Clear + Checkout row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClear"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/clear"
                                                app:cornerRadius="12dp"
                                                app:strokeColor="@color/pos_primary" />
                        android:textAllCaps="false"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckout"
                        style="@style/Widget.Material3.Button.UnelevatedButton"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1.4"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/checkout"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                                                android:textColor="@color/white"
                                                app:backgroundTint="@color/pos_secondary"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:contentDescription="@string/cart"
            android:src="@drawable/ic_cart_outline_24"
            app:backgroundTint="@color/pos_secondary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:maxImageSize="24dp"
            app:tint="@color/white" />

        <!-- Fragment host container (overlays POS content when visible) -->
        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/section_spacing"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_goneMarginTop="0dp" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
