<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.button.MaterialButton xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/btnCategory"
    style="@style/Widget.Material3.Button"
    android:layout_width="wrap_content"
    android:layout_height="@dimen/category_tab_height"
    android:layout_marginEnd="@dimen/content_inline_gap"
    android:insetTop="0dp"
    android:insetBottom="0dp"
    android:minWidth="0dp"
    android:paddingStart="14dp"
    android:paddingEnd="16dp"
    android:textAllCaps="false"
    android:textColor="@color/category_tab_text"
    android:textSize="13sp"
    android:textStyle="bold"
    app:backgroundTint="@color/category_tab_bg"
    app:cornerRadius="16dp"
    app:elevation="0dp"
    app:iconGravity="textStart"
    app:iconPadding="8dp"
    app:iconSize="16dp"
    app:iconTint="@color/category_tab_text" />
