<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/content_card_padding"
    android:paddingTop="14dp"
    android:paddingEnd="@dimen/content_card_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvOrderId"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.95"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
            android:textColor="@color/pos_text_primary"
            tools:text="#ORD-1024" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.55"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvOrderInitials"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_avatar_circle"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                android:textColor="@color/pos_primary"
                tools:text="SJ" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/content_inline_gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvOrderCustomerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                    android:textColor="@color/pos_text_primary"
                    tools:text="Sarah Johnson" />

                <TextView
                    android:id="@+id/tvOrderCustomerTable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
                    android:textColor="@color/pos_text_secondary"
                    tools:text="Table 12" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.55"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvOrderItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyLarge"
                android:textColor="@color/pos_text_primary"
                tools:text="Cappuccino, Croissant" />

            <TextView
                android:id="@+id/tvOrderItemCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
                android:textColor="@color/pos_text_secondary"
                tools:text="2 items" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvOrderTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.85"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyLarge"
            android:textColor="@color/pos_text_secondary"
            tools:text="10:24 AM" />

        <TextView
            android:id="@+id/tvOrderStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:background="@drawable/bg_hint_chip"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
            tools:text="Pending" />

        <TextView
            android:id="@+id/tvOrderTotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.95"
            android:gravity="end"
            android:paddingEnd="14dp"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
            android:textColor="@color/pos_text_primary"
            android:textStyle="bold"
            tools:text="PHP 12.50" />

        <ImageButton
            android:id="@+id/btnOrderActions"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_page_button"
            android:contentDescription="@string/order_actions"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more_vert_24"
            app:tint="@color/pos_text_secondary" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/pos_border" />
</LinearLayout>
