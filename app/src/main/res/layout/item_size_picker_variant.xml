<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/sizePickerVariantCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    app:cardBackgroundColor="@color/pos_surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/pos_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSizePickerVariantName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pos_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Grande" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSizePickerVariantPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pos_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="PHP 118.00" />

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@color/pos_text_secondary" />

                <TextView
                    android:id="@+id/tvSizePickerVariantStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pos_text_secondary"
                    android:textSize="12sp"
                    tools:text="65 left" />
            </LinearLayout>
        </LinearLayout>

        <!-- Add button shown when qty == 0 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSizePickerAdd"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minWidth="0dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/add_to_cart"
            android:textAllCaps="false"
            android:textColor="@color/pos_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="@color/pos_success_soft"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_add_18"
            app:iconPadding="4dp"
            app:iconSize="14dp"
            app:iconTint="@color/pos_secondary" />

        <!-- Stepper shown when qty >= 1 -->
        <LinearLayout
            android:id="@+id/sizePickerStepper"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_cart_stepper"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="3dp"
            android:visibility="gone"
            tools:visibility="visible">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSizePickerDecrease"
                style="@style/Widget.Material3.Button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/decrease_quantity"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/white"
                app:cornerRadius="10dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_remove_18"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="14dp"
                app:iconTint="@color/pos_primary" />

            <TextView
                android:id="@+id/tvSizePickerQuantity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/pos_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="2" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSizePickerIncrease"
                style="@style/Widget.Material3.Button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/increase_quantity"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                app:backgroundTint="@color/pos_primary"
                app:cornerRadius="10dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_add_18"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconSize="14dp"
                app:iconTint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
