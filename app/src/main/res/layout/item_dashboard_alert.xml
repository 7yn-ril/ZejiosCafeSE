<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/content_inline_gap"
    app:cardBackgroundColor="@color/pos_surface_soft"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/pos_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivAlertIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_warning_24"
                app:tint="@color/pos_warning" />

            <TextView
                android:id="@+id/tvAlertTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                android:textColor="@color/pos_text_primary"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/tvAlertLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hint_chip"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
                android:textColor="@color/pos_warning"
                tools:text="Warning" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAlertDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="32dp"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
            android:textColor="@color/pos_text_secondary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
