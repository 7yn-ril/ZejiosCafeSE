<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/pos_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_receipt_sheet"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="22dp">

        <!-- Brand header with circular logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_receipt_logo_circle">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_receipt_logo"
                    android:contentDescription="@string/receipt_brand_name"
                    app:tint="@color/white" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/receipt_brand_name"
                android:textColor="@color/pos_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/receipt_brand_tagline"
                android:textColor="@color/pos_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Dashed divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="14dp"
            android:background="@color/pos_divider" />

        <!-- Order info rows -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/receipt_order_label"
                android:textColor="@color/pos_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReceiptOrderId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pos_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="#POS-1024" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/receipt_time_label"
                android:textColor="@color/pos_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReceiptTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pos_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="12:45 PM" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/receipt_customer_label"
                android:textColor="@color/pos_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReceiptCustomer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pos_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Walk-in Customer" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/receipt_order_type_label"
                android:textColor="@color/pos_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReceiptOrderType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pos_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Dine In" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tableRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/receipt_table_label"
                android:textColor="@color/pos_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReceiptTable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pos_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="01" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/receipt_payment_method_label"
                android:textColor="@color/pos_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReceiptPayment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pos_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Cash" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:background="@color/pos_divider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/receipt_items_header"
            android:textColor="@color/pos_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:textAllCaps="true" />

        <LinearLayout
            android:id="@+id/receiptItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:background="@color/pos_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/subtotal"
                android:textColor="@color/pos_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvReceiptSubtotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pos_text_primary"
                android:textSize="13sp"
                tools:text="PHP 235.00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/total"
                android:textColor="@color/pos_text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReceiptTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pos_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="PHP 235.00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/receipt_cash_received_label"
                android:textColor="@color/pos_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReceiptCashReceived"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pos_text_primary"
                android:textSize="12sp"
                tools:text="PHP 300.00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/receipt_change_label"
                android:textColor="@color/pos_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvReceiptChange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pos_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="PHP 65.00" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="10dp"
            android:background="@color/pos_divider" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/receipt_thank_you"
            android:textColor="@color/pos_text_secondary"
            android:textSize="12sp"
            android:textStyle="italic" />
    </LinearLayout>
</ScrollView>
