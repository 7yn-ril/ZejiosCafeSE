<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:clipToPadding="false"
    android:padding="0dp">

    <LinearLayout
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_receipt_sheet"
        android:orientation="vertical"
        android:elevation="6dp"
        android:clipToOutline="true">

        <!-- Brand header (centered like a paper receipt) + X close button -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="44dp"
                android:paddingTop="18dp"
                android:paddingEnd="44dp"
                android:paddingBottom="6dp">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:src="@drawable/ic_logo_coffee_24"
                    android:contentDescription="@string/receipt_brand_name"
                    app:tint="@color/pos_primary_dark" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/receipt_brand_name"
                    android:textColor="@color/pos_primary_dark"
                    android:textSize="20sp"
                    android:letterSpacing="0.02"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/receipt_brand_tagline"
                    android:textColor="@color/pos_text_secondary"
                    android:textSize="10sp"
                    android:letterSpacing="0.02" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCloseReceipt"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/close_checkout"
                android:padding="6dp"
                android:src="@drawable/ic_close_24"
                app:tint="@color/pos_text_secondary" />
        </FrameLayout>

        <!-- Body -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="14dp">

            <!-- Dashed divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@drawable/divider_receipt_dash"
                android:layerType="software" />

            <!-- Order header: ID + time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvReceiptOrderId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:textColor="@color/pos_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="#POS-1087" />

                <TextView
                    android:id="@+id/tvReceiptTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pos_text_primary"
                    android:textSize="12sp"
                    tools:text="01:40 PM" />
            </LinearLayout>

            <!-- Customer / Order type / Payment -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/receipt_customer_label"
                    android:textColor="@color/pos_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvReceiptCustomer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pos_text_primary"
                    android:textSize="11sp"
                    tools:text="Walk-in Customer" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/receipt_order_type_label"
                    android:textColor="@color/pos_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvReceiptOrderType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pos_text_primary"
                    android:textSize="11sp"
                    tools:text="Dine In" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/receipt_payment_method_label"
                    android:textColor="@color/pos_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvReceiptPayment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pos_text_primary"
                    android:textSize="11sp"
                    tools:text="Cash" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/receiptPaymentReferenceRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/receipt_payment_reference_label"
                    android:textColor="@color/pos_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvReceiptPaymentReference"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/pos_text_primary"
                    android:textSize="11sp"
                    tools:text="cs_test_abc123" />
            </LinearLayout>

            <!-- Dashed divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/divider_receipt_dash"
                android:layerType="software" />

            <!-- Items table header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvReceiptTenderLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/items_label"
                    android:textColor="@color/pos_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="QTY"
                    android:textColor="@color/pos_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="88dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="@string/total_label"
                    android:textColor="@color/pos_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Items go here -->
            <LinearLayout
                android:id="@+id/receiptItemsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="vertical" />

            <!-- Dashed divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/divider_receipt_dash"
                android:layerType="software" />

            <!-- Subtotal -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvReceiptChangeLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/subtotal"
                    android:textColor="@color/pos_text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvReceiptSubtotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pos_text_primary"
                    android:textSize="11sp"
                    tools:text="PHP 295.00" />
            </LinearLayout>

            <!-- Discount row (conditional) -->
            <LinearLayout
                android:id="@+id/receiptDiscountRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvReceiptDiscountLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/pos_secondary"
                    android:textSize="11sp"
                    tools:text="Valentines Day (25%)" />

                <TextView
                    android:id="@+id/tvReceiptDiscountAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pos_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="-PHP 73.75" />
            </LinearLayout>

            <!-- Total (plain bold, no highlight box) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/total"
                    android:textAllCaps="true"
                    android:textColor="@color/pos_primary_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/tvReceiptTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pos_primary_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="PHP 221.25" />
            </LinearLayout>

            <!-- Cash row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/receipt_cash_received_label"
                    android:textAllCaps="true"
                    android:textColor="@color/pos_text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/tvReceiptCashReceived"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pos_text_primary"
                    android:textSize="11sp"
                    tools:text="PHP 225.00" />
            </LinearLayout>

            <!-- Change row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/receipt_change_label"
                    android:textAllCaps="true"
                    android:textColor="@color/pos_text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.06" />

                <TextView
                    android:id="@+id/tvReceiptChange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pos_secondary_dark"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="PHP 3.75" />
            </LinearLayout>

            <!-- Footer dashed divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/divider_receipt_dash"
                android:layerType="software" />

            <!-- Thank you footer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/receipt_thank_you"
                android:textAllCaps="true"
                android:textColor="@color/pos_primary_dark"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/receipt_thank_you_sub"
                android:textColor="@color/pos_text_secondary"
                android:textSize="10sp"
                android:textStyle="italic" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
