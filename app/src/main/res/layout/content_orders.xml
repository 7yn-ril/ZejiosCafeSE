<?xml version="1.0" encoding="utf-8"?>
<!--
    Orders content (landscape / tablet).
    The page title and subtitle are rendered by the shared MainActivity topBar
    (Dashboard / POS / Orders / Inventory share that header). Nothing in this
    file should duplicate that title.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_page_content_shell"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- ─────────────────────────────────────────────────────────────
             Section A — Action bar (POS-style)
             Search input is a standalone field with the Filter button
             sitting beside it. Both are 56dp tall so they line up flush
             along their top and bottom edges.
             ───────────────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/ordersSearchInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="@dimen/search_height"
                android:layout_weight="1"
                android:hint="@string/orders_search_hint"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusTopStart="18dp"
                app:boxStrokeColor="@color/pos_border"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:startIconDrawable="@drawable/ic_search_24"
                app:startIconTint="@color/pos_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOrderSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/pos_text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOrdersFilter"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/search_height"
                android:layout_marginStart="12dp"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:minWidth="134dp"
                android:text="@string/filter_sort"
                android:textAllCaps="false"
                android:textColor="@color/pos_primary"
                android:textSize="12sp"
                app:backgroundTint="@color/white"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_filter_24"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:iconTint="@color/pos_primary"
                app:strokeColor="@color/pos_primary"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- ─────────────────────────────────────────────────────────────
             Section B — Status pill row
             Wrapped in a white outlined container so the four filter
             pills sit inside one well-defined panel — the same visual
             grouping used by the POS category strip. The pills inside
             keep their selected/unselected backgrounds; this outer
             container just binds them visually.
             ───────────────────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_section_gap"
            android:background="@drawable/bg_category_strip"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:padding="8dp">

            <LinearLayout
                android:id="@+id/chipAllOrders"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/ivAllOrdersIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_orders_24"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvAllOrdersLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/all_orders"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                    android:textColor="@color/white"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAllOrdersCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_order_status_count_selected"
                    android:gravity="center"
                    android:minWidth="32dp"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="@string/all_orders_count"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
                    android:textColor="@color/pos_primary" />
            </LinearLayout>

            <Space
                android:layout_width="@dimen/content_inline_gap"
                android:layout_height="1dp" />

            <LinearLayout
                android:id="@+id/chipPreparingOrders"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/ivPreparingOrdersIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_coffee_24"
                    app:tint="@color/pos_primary_soft" />

                <TextView
                    android:id="@+id/tvPreparingOrdersLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/preparing"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                    android:textColor="@color/pos_text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvPreparingOrdersCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_page_button"
                    android:gravity="center"
                    android:minWidth="32dp"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="@string/preparing_orders_count"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
                    android:textColor="@color/pos_primary_soft"
                    android:textStyle="bold" />
            </LinearLayout>

            <Space
                android:layout_width="@dimen/content_inline_gap"
                android:layout_height="1dp" />

            <LinearLayout
                android:id="@+id/chipCompletedOrders"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_unselected"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="14dp">

                <ImageView
                    android:id="@+id/ivCompletedOrdersIcon"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_star_24"
                    app:tint="@color/pos_secondary" />

                <TextView
                    android:id="@+id/tvCompletedOrdersLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/completed"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                    android:textColor="@color/pos_text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCompletedOrdersCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_page_button"
                    android:gravity="center"
                    android:minWidth="32dp"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="@string/completed_orders_count"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
                    android:textColor="@color/pos_secondary"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ─────────────────────────────────────────────────────────────
             Section C — Orders table
             Sticky-looking column header band, then the row list, then a
             pagination footer. Total / Action columns are spaced out so
             the price doesn't collide with the trailing icon button.
             ───────────────────────────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_section_gap"
            app:cardBackgroundColor="@color/pos_surface_header"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hint_chip"
                    android:backgroundTint="@color/dashboard_section_soft"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/content_card_padding"
                    android:paddingTop="14dp"
                    android:paddingEnd="@dimen/content_card_padding"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.95"
                        android:text="@string/order_id_label"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                        android:textColor="@color/pos_text_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.55"
                        android:text="@string/customer_label"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                        android:textColor="@color/pos_text_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.55"
                        android:text="@string/items_label"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                        android:textColor="@color/pos_text_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.85"
                        android:text="@string/time_label"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                        android:textColor="@color/pos_text_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.9"
                        android:text="@string/status_label"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                        android:textColor="@color/pos_text_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.95"
                        android:gravity="end"
                        android:paddingEnd="14dp"
                        android:text="@string/total_label"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                        android:textColor="@color/pos_text_secondary" />

                    <TextView
                        android:layout_width="44dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/action_label"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                        android:textColor="@color/pos_text_secondary" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvOrders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    tools:listitem="@layout/item_management_order" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="2dp"
                    android:background="@color/pos_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvOrdersShowing"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
                        android:textColor="@color/pos_text_secondary"
                        tools:text="Showing 1 to 10 of 24 orders" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOrdersPrevPage"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/pagination_previous"
                        android:textAllCaps="false"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                        android:textColor="@color/pos_primary"
                        app:backgroundTint="@color/white"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/pos_primary"
                        app:strokeWidth="1dp" />

                    <TextView
                        android:id="@+id/tvOrdersPageInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:gravity="center"
                        android:minWidth="120dp"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                        android:textColor="@color/pos_text_primary"
                        tools:text="Page 1 of 3" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOrdersNextPage"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/pagination_next"
                        android:textAllCaps="false"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/pos_primary"
                        app:cornerRadius="14dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
