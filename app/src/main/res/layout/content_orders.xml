<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pos_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="@dimen/content_screen_padding"
    android:paddingTop="@dimen/content_screen_padding"
    android:paddingEnd="@dimen/content_screen_padding"
    android:paddingBottom="@dimen/content_screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/ordersSearchInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="@dimen/search_height"
                android:layout_weight="1"
                android:hint="@string/orders_search_hint"
                app:boxBackgroundColor="@color/pos_surface"
                app:boxCornerRadiusBottomEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusTopStart="18dp"
                app:boxStrokeColor="@color/pos_border"
                app:startIconDrawable="@drawable/ic_search_24"
                app:startIconTint="@color/pos_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOrderSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOrdersFilter"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/content_inline_gap"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/filter_sort"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                android:textColor="@color/pos_text_primary"
                app:backgroundTint="@color/pos_surface"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_filter_24"
                app:iconSize="18dp"
                app:iconPadding="6dp"
                app:iconTint="@color/pos_primary"
                app:strokeColor="@color/pos_border"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNewOrder"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/content_inline_gap"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/new_order"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                app:backgroundTint="@color/pos_secondary"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_add_18"
                app:iconSize="18dp"
                app:iconPadding="6dp"
                app:iconTint="@color/white" />
        </LinearLayout>

        <HorizontalScrollView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_section_gap"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_hint_chip"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/all_orders"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                        android:textColor="@color/pos_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_sidebar_item_selected"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="@string/all_orders_count"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
                        android:textColor="@color/white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pending"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                        android:textColor="@color/pos_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_hint_chip"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="@string/pending_orders_count"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
                        android:textColor="@color/pos_warning" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/preparing"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                        android:textColor="@color/pos_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_hint_chip"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="@string/preparing_orders_count"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
                        android:textColor="@color/pos_info" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/completed"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                        android:textColor="@color/pos_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_hint_chip"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="@string/completed_orders_count"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
                        android:textColor="@color/pos_secondary" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_section_gap"
            app:cardBackgroundColor="@color/pos_surface"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="2dp"
            app:strokeColor="@color/pos_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/pos_surface_soft"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/content_card_padding"
                    android:paddingTop="@dimen/content_section_gap"
                    android:paddingEnd="@dimen/content_card_padding"
                    android:paddingBottom="@dimen/content_section_gap">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.95"
                        android:text="@string/order_id_label"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                        android:textColor="@color/pos_text_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.55"
                        android:text="@string/customer_label"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                        android:textColor="@color/pos_text_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.55"
                        android:text="@string/items_label"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                        android:textColor="@color/pos_text_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.85"
                        android:text="@string/time_label"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                        android:textColor="@color/pos_text_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.9"
                        android:text="@string/status_label"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                        android:textColor="@color/pos_text_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.8"
                        android:gravity="end"
                        android:text="@string/total_label"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                        android:textColor="@color/pos_text_secondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.35"
                        android:gravity="center"
                        android:text="@string/action_label"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                        android:textColor="@color/pos_text_secondary" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvOrders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_management_order" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/content_card_padding"
                    android:paddingTop="@dimen/content_section_gap"
                    android:paddingEnd="@dimen/content_card_padding"
                    android:paddingBottom="@dimen/content_section_gap">

                    <TextView
                        android:id="@+id/tvOrdersShowing"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
                        android:textColor="@color/pos_text_secondary"
                        tools:text="Showing 1 to 6 of 24 orders" />

                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_page_button"
                        android:gravity="center"
                        android:text="&lt;"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                        android:textColor="@color/pos_text_secondary" />

                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_sidebar_item_selected"
                        android:gravity="center"
                        android:text="1"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                        android:textColor="@color/white" />

                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_page_button"
                        android:gravity="center"
                        android:text="2"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                        android:textColor="@color/pos_text_secondary" />

                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_page_button"
                        android:gravity="center"
                        android:text="3"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                        android:textColor="@color/pos_text_secondary" />

                    <TextView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_page_button"
                        android:gravity="center"
                        android:text="&gt;"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                        android:textColor="@color/pos_text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
