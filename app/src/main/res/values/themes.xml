<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ZejiosCafeSE" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/pos_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/pos_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="colorSecondaryContainer">@color/pos_sidebar_selected</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/pos_background</item>

        <!-- Bottom navigation dynamic theme attributes (light) -->
        <item name="bottomNavBackground">@color/pos_surface</item>
        <item name="bottomNavIconTint">@color/pos_primary_soft</item>
        <item name="bottomNavTextColor">@color/pos_primary_dark</item>
        <item name="bottomNavSelectedItemColor">#FFFFFF</item>

        <!-- All AlertDialog.Builder calls inherit our themed dialog. -->
        <item name="android:alertDialogTheme">@style/ThemeOverlay.ZejiosCafe.Dialog</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.ZejiosCafe.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ZejiosCafe.Dialog</item>
    </style>

    <!-- Dark theme: inherits light and overrides bottom nav + surface colors -->
    <style name="Theme.ZejiosCafeSE.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/pos_primary_soft</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/pos_secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="colorSecondaryContainer">@color/pos_sidebar_selected</item>
        <item name="colorOnSecondaryContainer">@color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#1C1410</item>

        <!-- Bottom navigation dynamic theme attributes (dark) -->
        <item name="bottomNavBackground">#2A1F17</item>
        <item name="bottomNavIconTint">#8C7A68</item>
        <item name="bottomNavTextColor">#D4A574</item>
        <item name="bottomNavSelectedItemColor">#2A1F17</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.ZejiosCafe.Dialog</item>
    </style>

    <style name="Theme.ZejiosCafeSE.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/zejios_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.ZejiosCafeSE</item>
    </style>

    <style name="ShapeAppearanceOverlay.ZejiosCafe.Image" parent="">
        <item name="cornerSize">18dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.ZejiosCafe.Thumbnail" parent="">
        <item name="cornerSize">16dp</item>
    </style>
</resources>
