    <style name="TextAppearance.ZejiosCafe.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="lineHeight">16sp</item>
    </style>

    <style name="TextAppearance.ZejiosCafe.CaptionStrong" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="lineHeight">16sp</item>
    </style>

    <style name="TextAppearance.ZejiosCafe.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="lineHeight">14sp</item>
    </style>

    <style name="TextAppearance.ZejiosCafe.KpiValue" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">normal</item>
        <item name="lineHeight">30sp</item>
    </style>

    <style name="TextAppearance.ZejiosCafe.SidebarTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.ZejiosCafe.SidebarItem" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="ShapeAppearance.Item.Indicator" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Active indicator covers both icon and label text -->
    <style name="Widget.ZejiosCafe.BottomNav.ActiveIndicator" parent="">
        <item name="android:width">120dp</item>
        <item name="android:height">72dp</item>
        <item name="android:color">?attr/colorSecondaryContainer</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Item.Indicator</item>
    </style>

    <style name="Widget.ZejiosCafe.BottomNav.NoIndicator" parent="">
        <item name="android:width">1dp</item>
        <item name="android:height">1dp</item>
        <item name="android:color">@android:color/transparent</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Item.Indicator</item>
    </style>

    <!-- ────────────────────────────────────────────────────────────────
         Themed AlertDialog
         Applied via `android:alertDialogTheme` in Theme.ZejiosCafeSE so
         every default `AlertDialog.Builder(context)` call across the app
         picks up the rounded card surface, project palette, and Poppins
         typography without per-call refactors.
         ──────────────────────────────────────────────────────────────── -->
    <style name="ThemeOverlay.ZejiosCafe.Dialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="colorPrimary">@color/pos_primary</item>
        <item name="colorAccent">@color/pos_primary</item>
        <item name="android:windowBackground">@drawable/bg_dialog_window</item>
        <item name="android:windowMinWidthMajor">62%</item>
        <item name="android:windowMinWidthMinor">86%</item>
        <item name="android:textColor">@color/pos_text_primary</item>
        <item name="android:textColorPrimary">@color/pos_text_primary</item>
        <item name="android:textColorSecondary">@color/pos_text_secondary</item>
        <item name="android:textColorTertiary">@color/pos_text_secondary</item>
        <item name="android:textColorHint">@color/pos_text_secondary</item>
        <item name="android:fontFamily">@font/poppins</item>
        <item name="fontFamily">@font/poppins</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.ZejiosCafe.Dialog.Button.Primary</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.ZejiosCafe.Dialog.Button.Subtle</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.ZejiosCafe.Dialog.Button.Subtle</item>
    </style>

    <!--
        Filled primary action pill (e.g. Save, Confirm, Add).
        Renders as a real CTA, not just a text link.
    -->
    <style name="Widget.ZejiosCafe.Dialog.Button.Primary" parent="android:Widget">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:background">@drawable/bg_dialog_btn_primary</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!--
        Outlined pill for cancel / back / dismiss actions.
        Visually distinct from the primary CTA, but still clearly clickable.
    -->
    <style name="Widget.ZejiosCafe.Dialog.Button.Subtle" parent="android:Widget">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/pos_text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:background">@drawable/bg_dialog_btn_outlined</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.ZejiosCafe.ReportSegmentedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">13sp</item>
        <item name="textAllCaps">false</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
