        <item name="android:textStyle">normal</item>
        <item name="lineHeight">32sp</item>
    </style>

    <style name="TextAppearance.ZejiosCafe.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">normal</item>
        <item name="lineHeight">28sp</item>
    </style>

    <style name="TextAppearance.ZejiosCafe.Headline" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
