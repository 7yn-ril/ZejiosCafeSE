<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.ZejiosCafe.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">normal</item>
        <item name="lineHeight">32sp</item>
    </style>

    <style name="TextAppearance.ZejiosCafe.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">normal</item>
        <item name="lineHeight">28sp</item>
    </style>

    <style name="TextAppearance.ZejiosCafe.Headline" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">normal</item>
        <item name="lineHeight">26sp</item>
    </style>

    <style name="TextAppearance.ZejiosCafe.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">normal</item>
        <item name="lineHeight">24sp</item>
    </style>

    <style name="TextAppearance.ZejiosCafe.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="lineHeight">20sp</item>
    </style>

    <style name="TextAppearance.ZejiosCafe.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
        <item name="lineHeight">20sp</item>
    </style>

    <style name="TextAppearance.ZejiosCafe.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="lineHeight">16sp</item>
    </style>

    <style name="TextAppearance.ZejiosCafe.CaptionStrong" parent="TextAppearance.Material3.BodySmall">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">normal</item>
        <item name="lineHeight">16sp</item>
    </style>

    <style name="TextAppearance.ZejiosCafe.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="lineHeight">14sp</item>
    </style>

    <style name="TextAppearance.ZejiosCafe.KpiValue" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/poppins_bold</item>
        <item name="android:fontFamily">@font/poppins_bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">normal</item>
        <item name="lineHeight">30sp</item>
    </style>

    <style name="TextAppearance.ZejiosCafe.SidebarTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.ZejiosCafe.SidebarItem" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="ShapeAppearance.Item.Indicator" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">24dp</item>
    </style>

    <!-- Active indicator covers both icon and label text -->
    <style name="Widget.ZejiosCafe.BottomNav.ActiveIndicator" parent="">
        <item name="android:width">120dp</item>
        <item name="android:height">72dp</item>
        <item name="android:color">?attr/colorSecondaryContainer</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Item.Indicator</item>
    </style>
</resources>
