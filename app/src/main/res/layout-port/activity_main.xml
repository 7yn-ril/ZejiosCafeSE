<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_canvas"
    tools:context=".MainActivity">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/sidebarContainer"
        android:layout_width="@dimen/sidebar_collapsed_width"
        android:layout_height="0dp"
        android:layout_margin="@dimen/screen_padding"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/sidebarSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_sidebar_surface"
            android:orientation="vertical"
            android:padding="@dimen/sidebar_padding">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/ivSidebarLogo"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_sidebar_logo_circle"
                    android:contentDescription="@string/app_name"
                    android:padding="4dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_pos_24"
                    android:translationY="4dp"
                    app:layout_constraintBottom_toBottomOf="@id/tvSidebarTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvSidebarTitle"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvSidebarTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/sidebar_cafe_name"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.SidebarTitle"
                    android:textColor="@color/white"
                    android:textStyle="normal"
                    app:layout_constraintEnd_toStartOf="@id/btnToggleSidebar"
                    app:layout_constraintStart_toEndOf="@id/ivSidebarLogo"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvSidebarSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="2dp"
                    android:text="@string/sidebar_cafe_subtitle"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
                    android:textColor="@color/pos_text_on_sidebar_muted"
                    android:textStyle="normal"
                    app:layout_constraintEnd_toStartOf="@id/btnToggleSidebar"
                    app:layout_constraintStart_toEndOf="@id/ivSidebarLogo"
                    app:layout_constraintTop_toBottomOf="@id/tvSidebarTitle" />

                <ImageButton
                    android:id="@+id/btnToggleSidebar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/toggle_sidebar"
                    android:src="@drawable/ic_menu_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/white" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Divider after header (hidden when collapsed) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="6dp"
                android:background="@color/pos_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="20dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/itemDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sidebar_item_height"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ivSidebarDashboard"
                        android:layout_width="@dimen/sidebar_icon_size"
                        android:layout_height="@dimen/sidebar_icon_size"
                        android:src="@drawable/ic_dashboard_24"
                        app:tint="@color/pos_text_on_sidebar" />

                    <TextView
                        android:id="@+id/tvSidebarDashboard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/dashboard"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.SidebarItem"
                        android:textColor="@color/pos_text_on_sidebar"
                        android:textStyle="normal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/itemPos"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sidebar_item_height"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_sidebar_item_selected"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ivSidebarPos"
                        android:layout_width="@dimen/sidebar_icon_size"
                        android:layout_height="@dimen/sidebar_icon_size"
                        android:src="@drawable/ic_pos_24"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tvSidebarPos"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/pos"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.SidebarItem"
                        android:textColor="@color/white"
                        android:textStyle="normal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/itemOrders"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sidebar_item_height"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ivSidebarOrders"
                        android:layout_width="@dimen/sidebar_icon_size"
                        android:layout_height="@dimen/sidebar_icon_size"
                        android:src="@drawable/ic_orders_24"
                        app:tint="@color/pos_text_on_sidebar" />

                    <TextView
                        android:id="@+id/tvSidebarOrders"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/orders"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.SidebarItem"
                        android:textColor="@color/pos_text_on_sidebar"
                        android:textStyle="normal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/itemInventory"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sidebar_item_height"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ivSidebarInventory"
                        android:layout_width="@dimen/sidebar_icon_size"
                        android:layout_height="@dimen/sidebar_icon_size"
                        android:src="@drawable/ic_inventory_24"
                        app:tint="@color/pos_text_on_sidebar" />

                    <TextView
                        android:id="@+id/tvSidebarInventory"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/inventory"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.SidebarItem"
                        android:textColor="@color/pos_text_on_sidebar"
                        android:textStyle="normal" />
                </LinearLayout>

                <!-- Divider between nav groups -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="10dp"
                    android:layout_marginHorizontal="4dp"
                    android:background="@color/pos_divider" />

                <LinearLayout
                    android:id="@+id/itemReports"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sidebar_item_height"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ivSidebarReports"
                        android:layout_width="@dimen/sidebar_icon_size"
                        android:layout_height="@dimen/sidebar_icon_size"
                        android:src="@drawable/ic_reports_24"
                        app:tint="@color/pos_text_on_sidebar" />

                    <TextView
                        android:id="@+id/tvSidebarReports"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/reports"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.SidebarItem"
                        android:textColor="@color/pos_text_on_sidebar"
                        android:textStyle="normal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/itemStaff"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sidebar_item_height"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ivSidebarStaff"
                        android:layout_width="@dimen/sidebar_icon_size"
                        android:layout_height="@dimen/sidebar_icon_size"
                        android:src="@drawable/ic_staff_24"
                        app:tint="@color/pos_text_on_sidebar" />

                    <TextView
                        android:id="@+id/tvSidebarStaff"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/staff"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.SidebarItem"
                        android:textColor="@color/pos_text_on_sidebar"
                        android:textStyle="normal" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/itemSettings"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/sidebar_item_height"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/ivSidebarSettings"
                        android:layout_width="@dimen/sidebar_icon_size"
                        android:layout_height="@dimen/sidebar_icon_size"
                        android:src="@drawable/ic_settings_24"
                        app:tint="@color/pos_text_on_sidebar" />

                    <TextView
                        android:id="@+id/tvSidebarSettings"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/settings"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.SidebarItem"
                        android:textColor="@color/pos_text_on_sidebar"
                        android:textStyle="normal" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/profileCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_profile_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:contentDescription="@string/profile_name"
                    android:padding="7dp"
                    android:src="@drawable/ic_staff_24"
                    app:tint="@color/pos_primary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_name"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                        android:textColor="@color/white"
                        android:textStyle="normal" />

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/profile_email"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
                        android:textColor="@color/pos_text_on_sidebar_muted"
                        android:textStyle="normal" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/screen_padding"
        android:layout_marginEnd="@dimen/screen_padding"
        android:layout_marginBottom="@dimen/screen_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/sidebarContainer"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Header bar -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/pos_surface"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="2dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="@color/pos_border"
            app:strokeWidth="1dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/section_spacing">

                <TextView
                    android:id="@+id/tvTopTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/pos_title"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.Title"
                    android:textColor="@color/pos_text_primary"
                    android:textStyle="normal"
                    app:layout_constraintEnd_toStartOf="@+id/notificationFrame"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTopSubtitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/pos_subtitle"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
                    android:textColor="@color/pos_text_secondary"
                    android:textStyle="normal"
                    app:layout_constraintEnd_toStartOf="@+id/notificationFrame"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTopTitle" />

                <FrameLayout
                    android:id="@+id/notificationFrame"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_notification_container"
                    app:layout_constraintBottom_toBottomOf="@id/avatar"
                    app:layout_constraintEnd_toStartOf="@id/avatar"
                    app:layout_constraintTop_toTopOf="@id/avatar">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/notifications"
                        android:src="@drawable/ic_notification_24" />

                    <TextView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="end|top"
                        android:background="@drawable/bg_notification_badge"
                        android:gravity="center"
                        android:text="@string/notification_count"
                        android:textColor="@color/pos_text_primary"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/avatar"
                    android:layout_width="@dimen/topbar_avatar_size"
                    android:layout_height="@dimen/topbar_avatar_size"
                    android:background="@drawable/bg_avatar_circle"
                    android:contentDescription="@string/profile_name"
                    android:padding="8dp"
                    android:src="@drawable/ic_staff_24"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="@color/pos_primary" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <include
            android:id="@+id/dashboardContent"
            layout="@layout/content_dashboard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/section_spacing"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar" />

        <include
            android:id="@+id/ordersContent"
            layout="@layout/content_orders"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/section_spacing"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar" />

        <include
            android:id="@+id/staffContent"
            layout="@layout/content_staff"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <include
            android:id="@+id/profileContent"
            layout="@layout/content_profile"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/section_spacing"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar" />

        <include
            android:id="@+id/placeholderContent"
            layout="@layout/content_placeholder"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/section_spacing"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/contentGuide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.62" />

        <!-- Left panel: search + categories + products -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/leftPanel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/section_spacing"
            android:background="@drawable/bg_order_summary"
            android:padding="@dimen/section_spacing"
            app:layout_constraintBottom_toTopOf="@id/contentGuide"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topBar">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/searchInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="@dimen/search_height"
                android:hint="@string/search_hint"
                app:boxBackgroundColor="@color/pos_surface_soft"
                app:boxCornerRadiusBottomEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusTopStart="18dp"
                app:boxStrokeColor="@color/pos_border"
                app:layout_constraintEnd_toStartOf="@+id/btnFilterSort"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:startIconDrawable="@drawable/ic_search_24"
                app:startIconTint="@color/pos_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterSort"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/content_inline_gap"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/filter_sort"
                android:textAllCaps="false"
                android:textColor="@color/pos_text_primary"
                app:backgroundTint="@color/pos_surface"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_filter_24"
                app:iconSize="18dp"
                app:iconPadding="6dp"
                app:iconTint="@color/pos_primary"
                app:layout_constraintBottom_toBottomOf="@id/searchInputLayout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/searchInputLayout"
                app:strokeColor="@color/pos_border"
                app:strokeWidth="1dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="0dp"
                android:layout_height="@dimen/category_tab_height"
                android:layout_marginTop="@dimen/section_spacing"
                android:clipToPadding="false"
                android:paddingEnd="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/searchInputLayout"
                tools:listitem="@layout/item_category_tab" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvProducts"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="@dimen/section_spacing"
                android:clipToPadding="false"
                android:paddingBottom="24dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rvCategories"
                tools:listitem="@layout/item_product" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Right panel (bottom in portrait): Current Order -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/rightPanel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/section_spacing"
            app:cardBackgroundColor="@color/pos_surface"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/contentGuide"
            app:strokeColor="@color/pos_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="@dimen/content_panel_padding">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="44dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/current_order"
                            android:textAppearance="@style/TextAppearance.ZejiosCafe.Headline"
                            android:textColor="@color/pos_text_primary"
                            android:textStyle="normal" />

                        <TextView
                            android:id="@+id/tvOrderNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
                            android:textColor="@color/pos_text_secondary"
                            android:textStyle="normal"
                            tools:text="Order #POS-1452" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnCloseCheckout"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="top|end"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/close_checkout"
                        android:padding="6dp"
                        android:src="@drawable/ic_close_24"
                        app:tint="@color/pos_text_secondary" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/emptyOrderState"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:src="@drawable/ic_cart_empty_24" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/no_items_added"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyLarge"
                        android:textColor="@color/pos_text_secondary"
                        android:textStyle="normal" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvOrderItems"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/content_inline_gap"
                    android:layout_weight="1"
                    android:visibility="gone"
                    tools:listitem="@layout/item_order" />

                <!-- Divider above totals -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/content_inline_gap"
                    android:layout_marginBottom="@dimen/content_inline_gap"
                    android:background="@color/pos_divider" />

                <!-- Totals section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/content_section_gap"
                    android:background="@drawable/bg_order_summary"
                    android:orientation="vertical"
                    android:padding="@dimen/content_card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/subtotal"
                            android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyLarge"
                            android:textColor="@color/pos_text_secondary" />

                        <TextView
                            android:id="@+id/tvSubtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                            android:textColor="@color/pos_text_primary"
                            android:textSize="13sp"
                            tools:text="PHP 235.00" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/tax"
                            android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyLarge"
                            android:textColor="@color/pos_text_secondary" />

                        <TextView
                            android:id="@+id/tvTax"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                            android:textColor="@color/pos_text_primary"
                            android:textSize="13sp"
                            tools:text="PHP 28.20" />
                    </LinearLayout>

                    <!-- Divider before total -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="8dp"
                        android:background="@color/pos_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/total"
                            android:textAppearance="@style/TextAppearance.ZejiosCafe.SectionTitle"
                            android:textColor="@color/pos_text_primary"
                            android:textStyle="normal" />

                        <TextView
                            android:id="@+id/tvTotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.ZejiosCafe.KpiValue"
                            android:textColor="@color/pos_text_primary"
                            android:textStyle="normal"
                            tools:text="PHP 263.20" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Payment method toggle buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/content_section_gap"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCash"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_weight="1"
                        android:text="@string/cash"
                        android:textAllCaps="false"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGcash"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/gcash"
                        android:textAllCaps="false"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCard"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/card"
                        android:textAllCaps="false"
                        app:cornerRadius="14dp" />
                </LinearLayout>

                <!-- Clear + Checkout row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/content_inline_gap"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClear"
                        style="@style/Widget.Material3.Button.UnelevatedButton"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:text="@string/clear"
                        android:textAllCaps="false"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCheckout"
                        style="@style/Widget.Material3.Button.UnelevatedButton"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1.35"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="@string/checkout"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabCart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/cart"
            android:src="@drawable/ic_cart_outline_24"
            app:backgroundTint="@color/pos_secondary"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:maxImageSize="24dp"
            app:tint="@color/white" />

        <!-- Fragment host container (overlays POS content when visible) -->
        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
