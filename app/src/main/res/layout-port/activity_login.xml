<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pos_background"
    android:fillViewport="true"
    tools:context=".LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/pos_surface_header"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <FrameLayout
                android:layout_width="176dp"
                android:layout_height="176dp"
                android:background="@drawable/bg_login_logo_frame"
                android:padding="8dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/login_logo_description"
                    android:scaleType="centerCrop"
                    android:src="@drawable/zejios_splash" />
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/login_brand_title"
                android:textAppearance="@style/TextAppearance.ZejiosCafe.Title"
                android:textColor="@color/pos_text_primary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="280dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/login_brand_subtitle"
                android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
                android:textColor="@color/pos_text_secondary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/pos_sidebar_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="28dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/login_logo_description"
                android:src="@drawable/ic_logo_coffee_24"
                app:tint="@color/pos_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/login_welcome_title"
                android:textAppearance="@style/TextAppearance.ZejiosCafe.Title"
                android:textColor="@color/white"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/login_welcome_message"
                android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                android:textColor="@color/pos_text_on_sidebar_muted" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/usernameInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:hint="@string/login_username_hint"
                app:boxBackgroundColor="@color/pos_surface_header"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="@color/pos_border"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintTextColor="@color/pos_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLoginUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="username"
                    android:gravity="center_vertical"
                    android:imeOptions="actionNext"
                    android:inputType="text"
                    android:minHeight="56dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:singleLine="true"
                    android:textColor="@color/pos_text_primary"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/passwordInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/login_password_hint"
                app:boxBackgroundColor="@color/pos_surface_header"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="@color/pos_border"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/pos_text_secondary"
                app:hintTextColor="@color/pos_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etLoginPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="password"
                    android:gravity="center_vertical"
                    android:imeOptions="actionDone"
                    android:inputType="textPassword"
                    android:minHeight="56dp"
                    android:paddingTop="14dp"
                    android:paddingBottom="14dp"
                    android:singleLine="true"
                    android:textColor="@color/pos_text_primary"
                    android:textSize="16sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <CheckBox
                android:id="@+id/checkboxRemember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:buttonTint="@color/pos_secondary"
                android:text="@string/login_remember_me"
                android:textColor="@color/pos_text_on_sidebar_muted"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/login_sign_in"
                android:textAllCaps="false"
                android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:backgroundTint="@color/pos_secondary"
                app:cornerRadius="18dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
