<?xml version="1.0" encoding="utf-8"?>
<!--
    Orders content (portrait).
    Mirrors the landscape design language but stacks the action bar
    vertically and lets the status pills scroll horizontally because the
    available width is too narrow for an even four-up row.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_page_content_shell"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Action bar: search on top, secondary actions below -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/ordersSearchInputLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="@dimen/search_height"
                android:hint="@string/orders_search_hint"
                app:boxBackgroundColor="@color/white"
                app:boxCornerRadiusBottomEnd="18dp"
                app:boxCornerRadiusBottomStart="18dp"
                app:boxCornerRadiusTopEnd="18dp"
                app:boxCornerRadiusTopStart="18dp"
                app:boxStrokeColor="@color/pos_border"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:startIconDrawable="@drawable/ic_search_24"
                app:startIconTint="@color/pos_text_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etOrderSearch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:textColor="@color/pos_text_primary"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOrdersFilter"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:maxLines="1"
                android:text="@string/filter_sort"
                android:textAllCaps="false"
                android:textColor="@color/pos_primary"
                android:textSize="12sp"
                app:backgroundTint="@color/white"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_filter_24"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:iconSize="16dp"
                app:iconTint="@color/pos_primary"
                app:strokeColor="@color/pos_primary"
                app:strokeWidth="1dp" />
        </LinearLayout>

        <!-- Status pills wrapped in a white outlined container, scrolls horizontally -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_section_gap"
            android:background="@drawable/bg_category_strip"
            android:padding="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/chipAllOrders"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:id="@+id/ivAllOrdersIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_orders_24"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tvAllOrdersLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/all_orders"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvAllOrdersCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_order_status_count_selected"
                        android:gravity="center"
                        android:minWidth="28dp"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="@string/all_orders_count"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
                        android:textColor="@color/pos_primary" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/chipPreparingOrders"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:id="@+id/ivPreparingOrdersIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_coffee_24"
                        app:tint="@color/pos_primary_soft" />

                    <TextView
                        android:id="@+id/tvPreparingOrdersLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/preparing"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                        android:textColor="@color/pos_text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPreparingOrdersCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_page_button"
                        android:gravity="center"
                        android:minWidth="28dp"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="@string/preparing_orders_count"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
                        android:textColor="@color/pos_primary_soft"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/chipCompletedOrders"
                    android:layout_width="160dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_chip_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:id="@+id/ivCompletedOrdersIcon"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_star_24"
                        app:tint="@color/pos_secondary" />

                    <TextView
                        android:id="@+id/tvCompletedOrdersLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/completed"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                        android:textColor="@color/pos_text_primary"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvCompletedOrdersCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_page_button"
                        android:gravity="center"
                        android:minWidth="28dp"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="3dp"
                        android:text="@string/completed_orders_count"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.Overline"
                        android:textColor="@color/pos_secondary"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Orders list card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_section_gap"
            app:cardBackgroundColor="@color/pos_surface_header"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/pos_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvOrders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    tools:listitem="@layout/item_management_order" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/pos_border" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvOrdersShowing"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
                        android:textColor="@color/pos_text_secondary"
                        tools:text="Showing 1 to 10 of 24 orders" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOrdersPrevPage"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/pagination_previous"
                            android:textAllCaps="false"
                            android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                            android:textColor="@color/pos_primary"
                            app:backgroundTint="@color/white"
                            app:cornerRadius="14dp"
                            app:strokeColor="@color/pos_primary"
                            app:strokeWidth="1dp" />

                        <TextView
                            android:id="@+id/tvOrdersPageInfo"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginStart="10dp"
                            android:gravity="center"
                            android:minWidth="120dp"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                            android:textColor="@color/pos_text_primary"
                            tools:text="Page 1 of 3" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOrdersNextPage"
                            style="@style/Widget.Material3.Button"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/pagination_next"
                            android:textAllCaps="false"
                            android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyMedium"
                            android:textColor="@color/white"
                            app:backgroundTint="@color/pos_primary"
                            app:cornerRadius="14dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
