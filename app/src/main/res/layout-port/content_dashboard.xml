<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pos_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingStart="@dimen/content_screen_padding"
    android:paddingTop="@dimen/content_screen_padding"
    android:paddingEnd="@dimen/content_screen_padding"
    android:paddingBottom="@dimen/content_screen_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/dashboard_snapshot_title"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.SectionTitle"
            android:textColor="@color/pos_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/dashboard_snapshot_subtitle"
            android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
            android:textColor="@color/pos_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_section_gap"
            android:orientation="horizontal">

            <include
                layout="@layout/view_dashboard_metric_single_stock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Space
                android:layout_width="@dimen/content_inline_gap"
                android:layout_height="1dp" />

            <include
                layout="@layout/view_dashboard_metric_single_active"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_section_gap"
            android:orientation="horizontal">

            <include
                layout="@layout/view_dashboard_metric_single"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Space
                android:layout_width="@dimen/content_inline_gap"
                android:layout_height="1dp" />

            <include
                layout="@layout/view_dashboard_metric_single_orders"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <include
            layout="@layout/view_dashboard_metric_single_profit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_section_gap" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_section_gap"
            app:cardBackgroundColor="@color/pos_surface"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="2dp"
            app:strokeColor="@color/pos_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sales_performance"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.SectionTitle"
                    android:textColor="@color/pos_text_primary"
                    android:textStyle="normal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/sales_performance_subtitle"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
                    android:textColor="@color/pos_text_secondary"
                    android:textStyle="normal" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilDashboardChartPeriod"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="152dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="@string/reports_range_label"
                    app:boxBackgroundColor="@color/pos_surface"
                    app:boxCornerRadiusBottomEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusTopStart="18dp"
                    app:boxStrokeColor="@color/pos_border"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="1dp">

                    <com.google.android.material.textfield.MaterialAutoCompleteTextView
                        android:id="@+id/dropdownDashboardChartPeriod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:completionThreshold="1"
                        android:dropDownHeight="wrap_content"
                        android:inputType="none"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textColor="@color/pos_text_primary"
                        android:textSize="13sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.github.mikephil.charting.charts.LineChart
                    android:id="@+id/chartSalesPerformance"
                    android:layout_width="match_parent"
                    android:layout_height="260dp"
                    android:layout_marginTop="18dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_section_gap"
            app:cardBackgroundColor="@color/pos_warning_soft"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="2dp"
            app:strokeColor="@color/pos_warning"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_focus_title"
                            android:textAppearance="@style/TextAppearance.ZejiosCafe.SectionTitle"
                            android:textColor="@color/pos_text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/dashboard_focus_subtitle"
                            android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
                            android:textColor="@color/pos_text_secondary" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvActionCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_hint_chip"
                        android:backgroundTint="@color/white"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="6dp"
                        android:textAppearance="@style/TextAppearance.ZejiosCafe.CaptionStrong"
                        android:textColor="@color/pos_warning"
                        tools:text="3 open tasks" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvActionHeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.Headline"
                    android:textColor="@color/pos_text_primary"
                    tools:text="Low stock: Coffee beans" />

                <TextView
                    android:id="@+id/tvActionSupport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.BodyLarge"
                    android:textColor="@color/pos_text_secondary"
                    tools:text="1 critical and 2 warning inventory issues should be handled early today." />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAlerts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_dashboard_alert" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_section_gap"
            app:cardBackgroundColor="@color/pos_surface"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="2dp"
            app:strokeColor="@color/pos_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/top_performing_items"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.SectionTitle"
                    android:textColor="@color/pos_text_primary"
                    android:textStyle="normal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/top_performing_items_subtitle"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
                    android:textColor="@color/pos_text_secondary"
                    android:textStyle="normal" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTopItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_dashboard_top_product" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_section_gap"
            app:cardBackgroundColor="@color/pos_surface"
            app:cardCornerRadius="@dimen/card_corner_radius"
            app:cardElevation="2dp"
            app:strokeColor="@color/pos_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/business_insights"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.SectionTitle"
                    android:textColor="@color/pos_text_primary"
                    android:textStyle="normal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/business_insights_subtitle"
                    android:textAppearance="@style/TextAppearance.ZejiosCafe.Caption"
                    android:textColor="@color/pos_text_secondary"
                    android:textStyle="normal" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvInsights"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_dashboard_insight" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
