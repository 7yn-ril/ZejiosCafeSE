<?xml version="1.0" encoding="utf-8"?>
<!--
    Outlined pill background for dialog negative / neutral buttons.
    Applied via Widget.ZejiosCafe.Dialog.Button.Outlined.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/pos_chip_bg">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/pos_surface_header" />
            <stroke
                android:width="1dp"
                android:color="@color/pos_border" />
        </shape>
    </item>
</ripple>
