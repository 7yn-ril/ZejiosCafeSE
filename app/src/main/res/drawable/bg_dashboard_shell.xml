<?xml version="1.0" encoding="utf-8"?>
<!--
    Outer page-content shell used by Dashboard, Orders, and Inventory.
    No stroke — the page surface should read as a single uninterrupted
    canvas without a grayish outline ring.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="30dp" />
    <solid android:color="@color/dashboard_shell_bg" />
</shape>
