<?xml version="1.0" encoding="utf-8"?>
<!--
    Outer container for the Ingredients ⇄ Can Produce mode toggle.
    Less round than a pill — radius matches the other cards/panels on
    the inventory page so the toggle reads as a structural panel rather
    than a floating chip.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="@color/pos_surface_header" />
    <stroke
        android:width="1dp"
        android:color="@color/pos_border" />
</shape>
