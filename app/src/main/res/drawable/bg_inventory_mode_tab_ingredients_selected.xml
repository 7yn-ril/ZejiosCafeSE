<?xml version="1.0" encoding="utf-8"?>
<!--
    Active tab background for the inventory mode toggle. Slightly less
    round than the outer container so the inset reads as a tab inside a
    panel, not a pill inside a pill.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="11dp" />
    <solid android:color="@color/pos_primary" />
</shape>
